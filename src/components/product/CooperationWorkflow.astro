---
import { type Locale, t } from "../../i18n/utils";
import SectionHeading from "../shared/SectionHeading.astro";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;

const steps = ["step1", "step2", "step3", "step4"];
---

<section class="bg-surface-100 py-16 px-6">
	<div class="max-w-6xl mx-auto">
		<SectionHeading title={t(locale, "product.workflow.title")} />
		<p class="text-center text-text-secondary text-lg mt-4 mb-12">
			{t(locale, "product.workflow.subtitle")}
		</p>

		<!-- Desktop: horizontal timeline -->
		<div class="hidden md:grid md:grid-cols-4 gap-8 relative">
			<!-- Connection line -->
			<div
				class="absolute top-5 left-0 right-0 h-0.5 bg-accent-500/30 mx-12"
			>
			</div>

			{
				steps.map((step, i) => (
					<div class="relative">
						<!-- Numbered circle -->
						<div class="flex justify-center mb-6">
							<div class="w-10 h-10 rounded-full bg-accent-500 text-white flex items-center justify-center font-heading font-bold text-lg relative z-10">
								{i + 1}
							</div>
						</div>

						<!-- Content -->
						<div class="text-center">
							<h3 class="font-heading font-semibold text-lg mb-3">
								{t(locale, `product.workflow.${step}.title`)}
							</h3>
							<p class="text-text-secondary text-sm">
								{t(locale, `product.workflow.${step}.description`)}
							</p>
						</div>
					</div>
				))
			}
		</div>

		<!-- Mobile: vertical timeline -->
		<div class="md:hidden space-y-8">
			{
				steps.map((step, i) => (
					<div class="flex gap-4">
						<!-- Numbered circle with vertical line -->
						<div class="flex flex-col items-center flex-shrink-0">
							<div class="w-10 h-10 rounded-full bg-accent-500 text-white flex items-center justify-center font-heading font-bold text-lg">
								{i + 1}
							</div>
							{i < steps.length - 1 && (
								<div class="w-0.5 bg-accent-500/30 flex-1 mt-2 min-h-[60px]" />
							)}
						</div>

						<!-- Content -->
						<div class="flex-1 pb-4">
							<h3 class="font-heading font-semibold text-lg mb-2">
								{t(locale, `product.workflow.${step}.title`)}
							</h3>
							<p class="text-text-secondary">
								{t(locale, `product.workflow.${step}.description`)}
							</p>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>
