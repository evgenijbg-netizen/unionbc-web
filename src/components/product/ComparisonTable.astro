---
import { type Locale, t } from "../../i18n/utils";
import SectionHeading from "../shared/SectionHeading.astro";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;

const rows = [
	"thickness",
	"weight",
	"installTime",
	"cuiRisk",
	"maintenance",
	"scaffolding",
	"fireRating",
	"flexibility",
];
---

<section class="py-16 px-6 bg-surface-100">
	<div class="max-w-5xl mx-auto">
		<SectionHeading title={t(locale, "product.comparison.title")} />
		<div class="overflow-x-auto mt-8">
			<table class="w-full border-collapse">
				<thead>
					<tr class="border-b border-surface-200">
						<th class="text-left py-3 px-4 text-text-secondary font-heading font-semibold">
							{t(locale, "product.comparison.parameterLabel")}
						</th>
						<th class="text-left py-3 px-4 text-accent-400 font-heading font-semibold">
							{t(locale, "product.comparison.tc101Label")}
						</th>
						<th class="text-left py-3 px-4 text-text-secondary font-heading font-semibold">
							{t(locale, "product.comparison.conventionalLabel")}
						</th>
					</tr>
				</thead>
				<tbody>
					{
						rows.map((row) => (
							<tr class="border-b border-surface-200">
								<td class="py-4 px-4">
									{t(locale, `product.comparison.${row}.label`)}
								</td>
								<td class="py-4 px-4 text-accent-400 font-semibold">
									{t(locale, `product.comparison.${row}.tc101`)}
								</td>
								<td class="py-4 px-4 text-text-secondary">
									{t(locale, `product.comparison.${row}.conventional`)}
								</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
	</div>
</section>
