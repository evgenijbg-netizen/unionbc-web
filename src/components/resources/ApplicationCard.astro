---
interface Props {
	title: string;
	description: string;
	icon?: string;
}

const { title, description, icon } = Astro.props;
const iconLetter = icon || title.charAt(0).toUpperCase();
---

<div class="bg-surface-800 border border-surface-700 rounded p-6">
	<div class="flex items-start gap-4">
		<div
			class="flex-shrink-0 w-12 h-12 rounded-full bg-accent-500/10 flex items-center justify-center"
		>
			<span class="text-accent-500 font-heading font-bold text-xl">{iconLetter}</span>
		</div>
		<div class="flex-1 min-w-0">
			<h3 class="font-heading font-semibold text-lg mb-2">{title}</h3>
			<p class="text-text-secondary text-sm leading-relaxed">{description}</p>
		</div>
	</div>
</div>
