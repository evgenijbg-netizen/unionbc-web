---
import ApplicationCard from "../../components/resources/ApplicationCard.astro";
import ApplicationGuide from "../../components/resources/ApplicationGuide.astro";
import DocumentCard from "../../components/resources/DocumentCard.astro";
import TestResultCard from "../../components/resources/TestResultCard.astro";
import SectionHeading from "../../components/shared/SectionHeading.astro";
import { type Locale, t } from "../../i18n/utils";
import BaseLayout from "../../layouts/BaseLayout.astro";

const locale: Locale = "en";
const title = t(locale, "certificates.meta.title");
const description = t(locale, "certificates.meta.description");
---

<BaseLayout title={title} description={description} pageKey="certificates">
	<div class="container mx-auto px-4 py-16">
		<SectionHeading
			title={t(locale, "certificates.page.title")}
			subtitle={t(locale, "certificates.page.subtitle")}
		/>

		<!-- Quick navigation -->
		<nav class="flex flex-wrap gap-4 mb-16 justify-center">
			<a href="#documents" class="px-4 py-2 bg-surface-800 rounded hover:bg-accent-500 transition-colors">
				{t(locale, "certificates.nav.documents")}
			</a>
			<a href="#tests" class="px-4 py-2 bg-surface-800 rounded hover:bg-accent-500 transition-colors">
				{t(locale, "certificates.nav.tests")}
			</a>
			<a href="#applications" class="px-4 py-2 bg-surface-800 rounded hover:bg-accent-500 transition-colors">
				{t(locale, "certificates.nav.applications")}
			</a>
			<a href="#guide" class="px-4 py-2 bg-surface-800 rounded hover:bg-accent-500 transition-colors">
				{t(locale, "certificates.nav.guide")}
			</a>
		</nav>

		<!-- Documents Section -->
		<section id="documents" class="mb-24">
			<h2 class="text-3xl font-heading font-bold mb-8">
				{t(locale, "certificates.sections.documents")}
			</h2>
			<div class="grid md:grid-cols-2 gap-6">
				<DocumentCard
					href="/documents/bezpecnostni-list.pdf"
					title={t(locale, "certificates.doc.safety_sheet.title")}
					description={t(locale, "certificates.doc.safety_sheet.description")}
				/>
				<DocumentCard
					href="/documents/expert-audit.pdf"
					title={t(locale, "certificates.doc.expert_audit.title")}
					description={t(locale, "certificates.doc.expert_audit.description")}
				/>
				<DocumentCard
					href="/documents/manual-aplikace.pdf"
					title={t(locale, "certificates.doc.manual.title")}
					description={t(locale, "certificates.doc.manual.description")}
				/>
				<div class="bg-surface-800 border border-surface-700 rounded p-6">
					<h3 class="font-heading font-semibold text-lg mb-2">
						{t(locale, "certificates.doc.product_cert.title")}
					</h3>
					<p class="text-text-secondary text-sm">
						{t(locale, "certificates.doc.product_cert.description")}
					</p>
				</div>
			</div>
		</section>

		<!-- Test Results Section -->
		<section id="tests" class="mb-24">
			<h2 class="text-3xl font-heading font-bold mb-8">
				{t(locale, "certificates.sections.tests")}
			</h2>
			<div class="grid md:grid-cols-2 gap-6">
				<TestResultCard
					locale={locale}
					title={t(locale, "certificates.test.test01.title")}
					description={t(locale, "certificates.test.test01.description")}
					pdfHref="/documents/test01.pdf"
				/>
				<TestResultCard
					locale={locale}
					title={t(locale, "certificates.test.test02.title")}
					description={t(locale, "certificates.test.test02.description")}
					pdfHref="/documents/test02.pdf"
				/>
				<TestResultCard
					locale={locale}
					title={t(locale, "certificates.test.test03.title")}
					description={t(locale, "certificates.test.test03.description")}
					pdfHref="/documents/test03.pdf"
				/>
				<TestResultCard
					locale={locale}
					title={t(locale, "certificates.test.test04.title")}
					description={t(locale, "certificates.test.test04.description")}
					pdfHref="/documents/test04.pdf"
				/>
				<TestResultCard
					locale={locale}
					title={t(locale, "certificates.test.test05.title")}
					description={t(locale, "certificates.test.test05.description")}
					pdfHref="/documents/test05.pdf"
				/>
				<TestResultCard
					locale={locale}
					title={t(locale, "certificates.test.temp_measurement.title")}
					description={t(locale, "certificates.test.temp_measurement.description")}
					pdfHref="/documents/mereni-teplot1.pdf"
				/>
				<TestResultCard
					locale={locale}
					title={t(locale, "certificates.test.thermal_calc.title")}
					description={t(locale, "certificates.test.thermal_calc.description")}
					pdfHref="/documents/mereniteplot2.pdf"
				/>
				<TestResultCard
					locale={locale}
					title={t(locale, "certificates.test.house_test.title")}
					description={t(locale, "certificates.test.house_test.description")}
					pdfHref="/documents/testy-domku.pdf"
				/>
				<TestResultCard
					locale={locale}
					title={t(locale, "certificates.test.methodology.title")}
					description={t(locale, "certificates.test.methodology.description")}
					pdfHref="/documents/metod-cz.pdf"
				/>
				<TestResultCard
					locale={locale}
					title={t(locale, "certificates.test.protocol.title")}
					description={t(locale, "certificates.test.protocol.description")}
					pdfHref="/documents/PROTOKOL-cz.pdf"
				/>
			</div>
		</section>

		<!-- Application Examples Section -->
		<section id="applications" class="mb-24">
			<h2 class="text-3xl font-heading font-bold mb-8">
				{t(locale, "certificates.sections.applications")}
			</h2>

			<div class="space-y-12">
				<!-- Industry -->
				<div>
					<h3 class="text-2xl font-heading font-semibold mb-6 text-accent-500">
						{t(locale, "certificates.app.industry.title")}
					</h3>
					<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
						<ApplicationCard
							title={t(locale, "certificates.app.cement.title")}
							description={t(locale, "certificates.app.cement.description")}
							icon="C"
						/>
						<ApplicationCard
							title={t(locale, "certificates.app.refinery.title")}
							description={t(locale, "certificates.app.refinery.description")}
							icon="R"
						/>
						<ApplicationCard
							title={t(locale, "certificates.app.food.title")}
							description={t(locale, "certificates.app.food.description")}
							icon="F"
						/>
						<ApplicationCard
							title={t(locale, "certificates.app.brewery.title")}
							description={t(locale, "certificates.app.brewery.description")}
							icon="B"
						/>
						<ApplicationCard
							title={t(locale, "certificates.app.paper.title")}
							description={t(locale, "certificates.app.paper.description")}
							icon="P"
						/>
					</div>
				</div>

				<!-- Construction -->
				<div>
					<h3 class="text-2xl font-heading font-semibold mb-6 text-accent-500">
						{t(locale, "certificates.app.construction.title")}
					</h3>
					<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
						<ApplicationCard
							title={t(locale, "certificates.app.roofs.title")}
							description={t(locale, "certificates.app.roofs.description")}
							icon="R"
						/>
						<ApplicationCard
							title={t(locale, "certificates.app.facades.title")}
							description={t(locale, "certificates.app.facades.description")}
							icon="F"
						/>
						<ApplicationCard
							title={t(locale, "certificates.app.halls.title")}
							description={t(locale, "certificates.app.halls.description")}
							icon="H"
						/>
					</div>
				</div>

				<!-- Transport/Marine -->
				<div>
					<h3 class="text-2xl font-heading font-semibold mb-6 text-accent-500">
						{t(locale, "certificates.app.transport.title")}
					</h3>
					<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
						<ApplicationCard
							title={t(locale, "certificates.app.ships.title")}
							description={t(locale, "certificates.app.ships.description")}
							icon="S"
						/>
						<ApplicationCard
							title={t(locale, "certificates.app.containers.title")}
							description={t(locale, "certificates.app.containers.description")}
							icon="C"
						/>
					</div>
				</div>
			</div>
		</section>

		<!-- Application Guide Section -->
		<section id="guide" class="mb-24">
			<h2 class="text-3xl font-heading font-bold mb-8">
				{t(locale, "certificates.sections.guide")}
			</h2>
			<ApplicationGuide locale={locale} />
		</section>
	</div>
</BaseLayout>
