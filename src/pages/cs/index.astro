---
import { Image } from "astro:assets";
import { getLocalizedPath } from "../../i18n/routes";
import { getLocaleFromUrl, t } from "../../i18n/utils";
import BaseLayout from "../../layouts/BaseLayout.astro";
import productImage from "../../assets/images/products/tc101-bucket.png";

const locale = getLocaleFromUrl(Astro.url);

const problemItems = [1, 2, 3, 4];
const solutionItems = [1, 2, 3, 4, 5];
const solutionCriteria = [1, 2, 3, 4];
const targetIndustries = ["energy", "petrochemical", "food", "paper", "construction", "marine", "maintenance"];
const whyusItems = [1, 2, 3, 4];
---

<BaseLayout
	title={t(locale, "site.title")}
	description={t(locale, "site.description")}
	pageKey="home"
>
	<!-- Hero Section -->
	<section class="py-24 px-6 text-center">
		<div class="max-w-4xl mx-auto">
			<h1 class="text-5xl md:text-7xl font-heading font-bold text-text-primary mb-4">
				{t(locale, "home.hero.title")}
			</h1>
			<p class="text-xl md:text-2xl text-accent-400 mb-6">
				{t(locale, "home.hero.subtitle")}
			</p>
			<p class="text-lg text-text-secondary mb-8">
				{t(locale, "home.hero.description")}
			</p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
				<a
					href={getLocalizedPath("contact", locale)}
					class="inline-block bg-accent-500 hover:bg-accent-400 text-white font-heading font-semibold px-8 py-3 rounded-sm transition"
				>
					{t(locale, "cta.consultation")}
				</a>
				<a
					href={getLocalizedPath("product", locale)}
					class="inline-block border border-accent-500 text-accent-400 hover:bg-accent-500/10 font-heading font-semibold px-8 py-3 rounded-sm transition"
				>
					{t(locale, "home.hero.learnMore")}
				</a>
			</div>
		</div>
	</section>

	<!-- Key Stats Section -->
	<section class="py-16 px-6">
		<div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
			<div class="bg-surface-200 border border-surface-200 rounded p-6 text-center">
				<p class="text-2xl font-heading text-accent-400 mb-2">
					{t(locale, "home.stats.temp_range")}
				</p>
				<p class="text-sm text-text-secondary">
					{t(locale, "home.stats.temp_range_label")}
				</p>
			</div>
			<div class="bg-surface-200 border border-surface-200 rounded p-6 text-center">
				<p class="text-2xl font-heading text-accent-400 mb-2">
					{t(locale, "home.stats.conductivity")}
				</p>
				<p class="text-sm text-text-secondary">
					{t(locale, "home.stats.conductivity_label")}
				</p>
			</div>
			<div class="bg-surface-200 border border-surface-200 rounded p-6 text-center">
				<p class="text-2xl font-heading text-accent-400 mb-2">
					{t(locale, "home.stats.application")}
				</p>
				<p class="text-sm text-text-secondary">
					{t(locale, "home.stats.application_label")}
				</p>
			</div>
			<div class="bg-surface-200 border border-surface-200 rounded p-6 text-center">
				<p class="text-2xl font-heading text-accent-400 mb-2">
					{t(locale, "home.stats.certified")}
				</p>
				<p class="text-sm text-text-secondary">
					{t(locale, "home.stats.certified_label")}
				</p>
			</div>
		</div>
	</section>

	<!-- Product Image Section -->
	<section class="py-12 px-6">
		<div class="max-w-3xl mx-auto">
			<Image
				src={productImage}
				alt={t(locale, "product.hero.imageAlt")}
				width={800}
				height={573}
				format="webp"
				quality={85}
				class="rounded-lg shadow-xl w-full h-auto"
			/>
		</div>
	</section>

	<!-- Problem Section (NEW) -->
	<section class="py-16 px-6 bg-surface-100">
		<div class="max-w-6xl mx-auto">
			<h2 class="text-3xl md:text-4xl font-heading font-bold text-text-primary text-center mb-4">
				{t(locale, "home.problem.title")}
			</h2>
			<p class="text-lg text-text-secondary text-center mb-12 max-w-3xl mx-auto">
				{t(locale, "home.problem.subtitle")}
			</p>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
				{
					problemItems.map((num) => (
						<div class="bg-white border border-surface-200 rounded-lg p-6 flex gap-4">
							<div class="flex-shrink-0">
								<svg
									class="w-6 h-6 text-accent-400"
									fill="none"
									stroke="currentColor"
									viewBox="0 0 24 24"
								>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										stroke-width="2"
										d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
									/>
								</svg>
							</div>
							<p class="text-text-secondary">{t(locale, `home.problem.item${num}`)}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- Solution Section (RESTRUCTURED) -->
	<section class="py-16 px-6">
		<div class="max-w-6xl mx-auto">
			<h2 class="text-3xl md:text-4xl font-heading font-bold text-text-primary text-center mb-4">
				{t(locale, "home.solution.title")}
			</h2>
			<p class="text-lg text-text-secondary text-center mb-12 max-w-3xl mx-auto">
				{t(locale, "home.solution.subtitle")}
			</p>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
				{
					solutionItems.map((num) => (
						<div class="flex gap-4">
							<div class="flex-shrink-0">
								<div class="w-12 h-12 rounded-full bg-accent-500/20 flex items-center justify-center">
									<svg
										class="w-6 h-6 text-accent-400"
										fill="none"
										stroke="currentColor"
										viewBox="0 0 24 24"
									>
										<path
											stroke-linecap="round"
											stroke-linejoin="round"
											stroke-width="2"
											d="M5 13l4 4L19 7"
										/>
									</svg>
								</div>
							</div>
							<div>
								<h3 class="text-xl font-heading font-semibold text-text-primary mb-2">
									{t(locale, `home.solution.item${num}.title`)}
								</h3>
								<p class="text-text-secondary">{t(locale, `home.solution.item${num}.description`)}</p>
							</div>
						</div>
					))
				}
			</div>
			<div class="bg-surface-100 rounded-lg p-8">
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
					{
						solutionCriteria.map((num) => (
							<div class="text-center">
								<p class="text-sm text-text-secondary">{t(locale, `home.solution.criteria${num}`)}</p>
							</div>
						))
					}
				</div>
			</div>
		</div>
	</section>

	<!-- Target Industries Section (RESTRUCTURED) -->
	<section class="py-16 px-6 bg-surface-100">
		<div class="max-w-6xl mx-auto">
			<h2 class="text-3xl md:text-4xl font-heading font-bold text-text-primary text-center mb-12">
				{t(locale, "home.target.title")}
			</h2>
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
				{
					targetIndustries.map((industry) => (
						<div class="bg-white border border-surface-200 rounded-lg p-5">
							<h3 class="text-lg font-heading font-semibold text-text-primary mb-2">
								{t(locale, `home.target.${industry}.title`)}
							</h3>
							<p class="text-sm text-text-secondary">
								{t(locale, `home.target.${industry}.description`)}
							</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- Why UNION B+C Section (NEW) -->
	<section class="py-16 px-6">
		<div class="max-w-5xl mx-auto">
			<h2 class="text-3xl md:text-4xl font-heading font-bold text-text-primary text-center mb-12">
				{t(locale, "home.whyus.title")}
			</h2>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
				{
					whyusItems.map((num) => (
						<div class="border-l-4 border-accent-500 pl-6">
							<h3 class="text-xl font-heading font-semibold text-text-primary mb-2">
								{t(locale, `home.whyus.item${num}.title`)}
							</h3>
							<p class="text-text-secondary">{t(locale, `home.whyus.item${num}.description`)}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- CTA Section -->
	<section class="py-16 px-6 bg-surface-100">
		<div class="max-w-3xl mx-auto text-center">
			<h2 class="text-3xl md:text-4xl font-heading font-bold text-text-primary mb-4">
				{t(locale, "home.cta.title")}
			</h2>
			<p class="text-lg text-text-secondary mb-8">
				{t(locale, "home.cta.description")}
			</p>
			<a
				href={getLocalizedPath("contact", locale)}
				class="inline-block bg-accent-500 hover:bg-accent-400 text-white font-heading font-semibold px-8 py-3 rounded-sm transition"
			>
				{t(locale, "home.cta.button")}
			</a>
		</div>
	</section>
</BaseLayout>
