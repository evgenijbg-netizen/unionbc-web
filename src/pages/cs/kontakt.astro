---
import { type Locale, t } from "../../i18n/utils";
import BaseLayout from "../../layouts/BaseLayout.astro";

const locale: Locale = "cs";
---

<BaseLayout
	title={t(locale, "contact.meta.title")}
	description={t(locale, "contact.meta.description")}
	pageKey="contact"
>
	<div class="max-w-5xl mx-auto px-6 py-16">
		{/* Page heading */}
		<header class="mb-12 text-center">
			<h1 class="text-4xl md:text-5xl font-heading font-bold mb-4">
				{t(locale, "contact.page.title")}
			</h1>
			<p class="text-lg text-text-secondary max-w-2xl mx-auto">
				{t(locale, "contact.page.subtitle")}
			</p>
		</header>

		{/* Contact person card */}
		<div class="bg-surface-200 border border-accent-500/30 rounded-lg p-8 mb-8">
			<div class="text-center">
				<h2 class="text-2xl font-heading font-bold mb-2">
					{t(locale, "contact.person.name")}
				</h2>
				<p class="text-accent-400 font-medium mb-1">
					{t(locale, "contact.person.role")}
				</p>
				<p class="text-text-secondary">
					{t(locale, "contact.person.subtitle")}
				</p>
			</div>
		</div>

		{/* Contact details grid */}
		<div class="grid md:grid-cols-2 gap-6 mb-8">
			{/* Phone */}
			<div class="bg-surface-200 border border-surface-200 rounded-lg p-6">
				<h3 class="text-sm font-bold text-text-secondary uppercase tracking-wide mb-3">
					{t(locale, "contact.phone.label")}
				</h3>
				<a
					href={`tel:${t(locale, "footer.phone").replace(/\s/g, "")}`}
					class="text-2xl font-heading font-bold text-accent-400 hover:text-accent-300 transition-colors block"
				>
					{t(locale, "footer.phone")}
				</a>
			</div>

			{/* Email */}
			<div class="bg-surface-200 border border-surface-200 rounded-lg p-6">
				<h3 class="text-sm font-bold text-text-secondary uppercase tracking-wide mb-3">
					{t(locale, "contact.email.label")}
				</h3>
				<a
					href={`mailto:${t(locale, "footer.email")}`}
					class="text-2xl font-heading font-bold text-accent-400 hover:text-accent-300 transition-colors block break-all"
				>
					{t(locale, "footer.email")}
				</a>
			</div>

			{/* Address */}
			<div class="bg-surface-200 border border-surface-200 rounded-lg p-6">
				<h3 class="text-sm font-bold text-text-secondary uppercase tracking-wide mb-3">
					{t(locale, "contact.address.label")}
				</h3>
				<p class="text-lg mb-3">
					{t(locale, "contact.address.value")}
				</p>
				<a
					href={t(locale, "contact.map.url")}
					target="_blank"
					rel="noopener noreferrer"
					class="text-accent-400 hover:text-accent-300 transition-colors inline-flex items-center gap-1"
				>
					{t(locale, "contact.map.link")}
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
						></path>
					</svg>
				</a>
			</div>

			{/* Company info */}
			<div class="bg-surface-200 border border-surface-200 rounded-lg p-6">
				<h3 class="text-sm font-bold text-text-secondary uppercase tracking-wide mb-3">
					{t(locale, "contact.company.name")}
				</h3>
				<p class="text-lg">
					<span class="text-text-secondary">{t(locale, "contact.company.id.label")}:</span>
					{" "}
					{t(locale, "contact.company.id.value")}
				</p>
			</div>
		</div>

		{/* CTA section */}
		<div class="bg-gradient-to-br from-accent-500/10 to-accent-500/5 border border-accent-500/30 rounded-lg p-8 text-center">
			<h2 class="text-2xl md:text-3xl font-heading font-bold mb-3">
				{t(locale, "contact.cta.title")}
			</h2>
			<p class="text-text-secondary mb-6 max-w-2xl mx-auto">
				{t(locale, "contact.cta.description")}
			</p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
				<a
					href={`tel:${t(locale, "footer.phone").replace(/\s/g, "")}`}
					class="inline-flex items-center gap-2 bg-accent-500 hover:bg-accent-600 text-white font-heading font-bold py-3 px-8 rounded transition-colors"
				>
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
						></path>
					</svg>
					{t(locale, "footer.phone")}
				</a>
				<a
					href={`mailto:${t(locale, "footer.email")}`}
					class="inline-flex items-center gap-2 bg-surface-700 hover:bg-surface-600 text-white font-heading font-bold py-3 px-8 rounded transition-colors"
				>
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
						></path>
					</svg>
					{t(locale, "footer.email")}
				</a>
			</div>
		</div>
	</div>
</BaseLayout>
