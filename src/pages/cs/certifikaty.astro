---
import DocumentCard from "../../components/resources/DocumentCard.astro";
import TestResultCard from "../../components/resources/TestResultCard.astro";
import SectionHeading from "../../components/shared/SectionHeading.astro";
import { type Locale, t } from "../../i18n/utils";
import BaseLayout from "../../layouts/BaseLayout.astro";

const locale: Locale = "cs";
const title = t(locale, "certificates.meta.title");
const description = t(locale, "certificates.meta.description");
---

<BaseLayout title={title} description={description} pageKey="certificates">
	<div class="container mx-auto px-4 py-16">
		<SectionHeading
			title={t(locale, "certificates.page.title")}
			subtitle={t(locale, "certificates.page.subtitle")}
		/>

		<!-- Quick navigation -->
		<nav class="flex flex-wrap gap-4 mb-16 justify-center">
			<a href="#documents" class="px-4 py-2 bg-surface-200 rounded hover:bg-accent-500 hover:text-white transition-colors">
				{t(locale, "certificates.nav.documents")}
			</a>
			<a href="#tests" class="px-4 py-2 bg-surface-200 rounded hover:bg-accent-500 hover:text-white transition-colors">
				{t(locale, "certificates.nav.tests")}
			</a>
		</nav>

		<!-- Documents Section -->
		<section id="documents" class="mb-24">
			<h2 class="text-3xl font-heading font-bold mb-8">
				{t(locale, "certificates.sections.documents")}
			</h2>
			<div class="grid md:grid-cols-2 gap-6">
				<DocumentCard
					href="/documents/bezpecnostni-list.pdf"
					title={t(locale, "certificates.doc.safety_sheet.title")}
					description={t(locale, "certificates.doc.safety_sheet.description")}
				/>
				<DocumentCard
					href="/documents/expert-audit.pdf"
					title={t(locale, "certificates.doc.expert_audit.title")}
					description={t(locale, "certificates.doc.expert_audit.description")}
				/>
				<DocumentCard
					href="/documents/manual-aplikace.pdf"
					title={t(locale, "certificates.doc.manual.title")}
					description={t(locale, "certificates.doc.manual.description")}
				/>
				<div class="bg-surface-200 border border-surface-200 rounded p-6">
					<h3 class="font-heading font-semibold text-lg mb-2">
						{t(locale, "certificates.doc.product_cert.title")}
					</h3>
					<p class="text-text-secondary text-sm">
						{t(locale, "certificates.doc.product_cert.description")}
					</p>
				</div>
			</div>
		</section>

		<!-- Test Results Section -->
		<section id="tests" class="mb-24">
			<h2 class="text-3xl font-heading font-bold mb-8">
				{t(locale, "certificates.sections.tests")}
			</h2>
			<div class="grid md:grid-cols-2 gap-6">
				<TestResultCard
					locale={locale}
					title={t(locale, "certificates.test.test01.title")}
					description={t(locale, "certificates.test.test01.description")}
					pdfHref="/documents/test01.pdf"
				/>
				<TestResultCard
					locale={locale}
					title={t(locale, "certificates.test.test02.title")}
					description={t(locale, "certificates.test.test02.description")}
					pdfHref="/documents/test02.pdf"
				/>
				<TestResultCard
					locale={locale}
					title={t(locale, "certificates.test.test03.title")}
					description={t(locale, "certificates.test.test03.description")}
					pdfHref="/documents/test03.pdf"
				/>
				<TestResultCard
					locale={locale}
					title={t(locale, "certificates.test.test04.title")}
					description={t(locale, "certificates.test.test04.description")}
					pdfHref="/documents/test04.pdf"
				/>
				<TestResultCard
					locale={locale}
					title={t(locale, "certificates.test.test05.title")}
					description={t(locale, "certificates.test.test05.description")}
					pdfHref="/documents/test05.pdf"
				/>
				<TestResultCard
					locale={locale}
					title={t(locale, "certificates.test.temp_measurement.title")}
					description={t(locale, "certificates.test.temp_measurement.description")}
					pdfHref="/documents/mereni-teplot1.pdf"
				/>
				<TestResultCard
					locale={locale}
					title={t(locale, "certificates.test.thermal_calc.title")}
					description={t(locale, "certificates.test.thermal_calc.description")}
					pdfHref="/documents/mereniteplot2.pdf"
				/>
				<TestResultCard
					locale={locale}
					title={t(locale, "certificates.test.house_test.title")}
					description={t(locale, "certificates.test.house_test.description")}
					pdfHref="/documents/testy-domku.pdf"
				/>
				<TestResultCard
					locale={locale}
					title={t(locale, "certificates.test.methodology.title")}
					description={t(locale, "certificates.test.methodology.description")}
					pdfHref="/documents/metod-cz.pdf"
				/>
				<TestResultCard
					locale={locale}
					title={t(locale, "certificates.test.protocol.title")}
					description={t(locale, "certificates.test.protocol.description")}
					pdfHref="/documents/PROTOKOL-cz.pdf"
				/>
			</div>
		</section>
	</div>
</BaseLayout>
